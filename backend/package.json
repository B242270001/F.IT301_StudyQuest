{
  "name": "studyquest-backend",
  "version": "1.0.0",
  "description": "StudyQuest Backend — Lab 4",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:ci": "jest --forceExit --detectOpenHandles --ci"
  },
  "dependencies": {
    "cors": "*",
    "express": "*",
    "multer": "*"
  },
  "devDependencies": {
    "jest": "*",
    "supertest": "*"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
