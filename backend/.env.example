# Backend-ийг асаахаас өмнө энэ файлыг .env болгон хуулж утгыг өөрчилнө.
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/studyquest
# MongoDB Atlas жишээ:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studyquest
PORT=4000

# Lab 6: JWT гарын үсгийн нууц түлхүүр (урт, санамсаргүй утга). Production-д заавал.
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
