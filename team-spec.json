  "authScenario": {
    "taskId": "TASK-01",
    "mode": "bearer",
    "description": "JWT (HS256) Authorization: Bearer <token>. Token-ий jti MongoDB Session-д хадгалагдаж logout хийхэд хүчингүй болно.",
    "register": {
      "method": "POST",
      "path": "/api/auth/register",
      "body": { "username": "lab6user", "password": "secret123", "displayName": "Лаб6 Хэрэглэгч", "gender": "female" },
      "expectedStatus": 201,
      "tokenField": "token"
    },
    "login": {
      "method": "POST",
      "path": "/api/auth/login",
      "body": { "username": "temuulen", "password": "student123" },
      "expectedStatus": 200,
      "tokenField": "token"
    },
    "protected": [
      { "method": "GET", "path": "/api/user/profile", "authorizedStatus": 200, "anonymousStatus": 401 },
      { "method": "GET", "path": "/api/notes", "authorizedStatus": 200, "anonymousStatus": 401 },
      { "method": "GET", "path": "/api/user/avatar", "authorizedStatus": 200, "anonymousStatus": 401 }
    ],
    "roleProtected": [
      {
        "method": "DELETE",
        "path": "/api/users/U07",
        "requiredRole": "TEACHER",
        "anonymousStatus": 401,
        "forbidden": { "login": { "username": "temuulen", "password": "student123" }, "expectedStatus": 403 },
        "allowed": { "login": { "username": "bagsh", "password": "teacher123" }, "expectedStatus": 204 }
      }
    ],
    "logout": { "method": "POST", "path": "/api/auth/logout", "expectedStatus": 204, "tokenRevoked": true }
  },
  "scenarios": [
    {
      "id": "task01-register-integration",
      "taskId": "TASK-01",
      "tags": ["integration", "auth"],
      "route": "/register",
      "description": "Lab 6: /register дээр бүртгүүлэхэд POST /api/auth/register (201, JWT) хүсэлт гарч, шууд /dashboard нээгдэнэ.",
      "steps": [
        { "action": "goto", "url": "/register" },
        { "action": "fill", "testId": "register-username-input", "value": "e2e.{timestamp}" },
        { "action": "fill", "testId": "register-displayName-input", "value": "E2E Хэрэглэгч" },
        { "action": "fill", "testId": "register-password-input", "value": "secret123" },
        { "action": "fill", "testId": "register-confirm-input", "value": "secret123" },
        { "action": "click", "testId": "register-submit-btn" },
        { "action": "expectRequest", "method": "POST", "path": "/api/auth/register" },
        { "action": "expectVisible", "testId": "page-dashboard" }
      ]
    },
    {
      "id": "task01-notes-integration",
      "taskId": "TASK-01",
      "tags": ["integration"],
      "route": "/dashboard",
      "description": "Lab 5: Dashboard дээр тэмдэглэл нэмэхэд POST /api/notes хүсэлт гарч MongoDB-д хадгалагдана, reload хийхэд GET /api/notes-ээр хэвээр харагдана.",
      "steps": [
        { "action": "goto", "url": "/login" },
        { "action": "fill", "testId": "login-name-input", "value": "anujin" },
        { "action": "fill", "testId": "login-password-input", "value": "student123" },
        { "action": "click", "testId": "login-submit-btn" },
        { "action": "expectVisible", "testId": "page-dashboard" },
        { "action": "click", "testId": "add-note-interactive-btn" },
        { "action": "fill", "testId": "note-textarea", "value": "Lab5 integration note" },
        { "action": "click", "testId": "save-note-btn" },
        { "action": "expectRequest", "method": "POST", "path": "/api/notes" },
        { "action": "expectVisible", "testId": "notes-success" },
        { "action": "expectText", "text": "Lab5 integration note" }
      ]
    },
    {
      "id": "task01-auth-role",
      "taskId": "TASK-01",
      "tags": ["role"],
      "route": "/login",
      "description": "Зөв нэр/нууц үгээр нэвтэрч /dashboard нээгдэнэ, room-computer харагдана.",
      "steps": [
        { "action": "goto", "url": "/login" },
        { "action": "fill", "testId": "login-name-input", "value": "temuulen" },
        { "action": "fill", "testId": "login-password-input", "value": "student123" },
        { "action": "click", "testId": "login-submit-btn" },
        { "action": "expectVisible", "testId": "page-dashboard" },
        { "action": "expectVisible", "testId": "room-computer" }
      ]
    },
    {
      "id": "task01-auth-validation",
      "taskId": "TASK-01",
      "tags": ["validation"],
      "route": "/login",
      "description": "Хоосон нэр нууц үг оруулахад validation алдааны мэдээлэл харуулна.",
      "steps": [
        { "action": "goto", "url": "/login" },
        { "action": "click", "testId": "login-submit-btn" },
        { "action": "expectVisible", "testId": "login-name-error" },
        { "action": "expectVisible", "testId": "login-password-error" }
      ]
    },
    {
      "id": "task03-path-role",
      "taskId": "TASK-03",
      "tags": ["role"],
      "route": "/practice/C01",
      "description": "STUDENT эрхээр зөвхөн суралцах зам харагдана, TEACHER эрх рүү шилжихэд нэгж/сэдэв удирдах CRUD самбар нээгдэнэ.",
      "steps": [
        { "action": "goto", "url": "/practice/C01" },
        { "action": "expectHidden", "testId": "teacher-path-controls" },
        { "action": "click", "testId": "role-toggle-btn" },
        { "action": "expectVisible", "testId": "teacher-path-controls" }
      ]
    },
    {
      "id": "task03-path-validation",
      "taskId": "TASK-03",
      "tags": ["validation"],
      "route": "/practice/C01",
      "description": "Нэгж нэмэх форм дээр хоосон нэр болон буруу XP утга оруулахад validation алдааны мэдээлэл харуулна.",
      "steps": [
        { "action": "goto", "url": "/practice/C01" },
        { "action": "click", "testId": "role-toggle-btn" },
        { "action": "click", "testId": "open-create-unit-btn" },
        { "action": "fill", "testId": "unit-title-input", "value": "" },
        { "action": "fill", "testId": "unit-xp-input", "value": "3" },
        { "action": "click", "testId": "save-unit-btn" },
        { "action": "expectVisible", "testId": "error-unit-title" },
        { "action": "expectVisible", "testId": "error-unit-xp" }
      ]
    },
    {
      "id": "task03-path-crud",
      "taskId": "TASK-03",
      "tags": ["crud"],
      "route": "/practice/C01",
      "description": "Сургалтын замналын нэгж дээр Create -> Read -> Update -> Delete бүтэн урсгал ажиллана.",
      "steps": [
        { "action": "goto", "url": "/practice/C01" },
        { "action": "click", "testId": "role-toggle-btn" },
        { "action": "click", "testId": "open-create-unit-btn" },
        { "action": "fill", "testId": "unit-title-input", "value": "Custom Hooks" },
        { "action": "fill", "testId": "unit-xp-input", "value": "60" },
        { "action": "click", "testId": "save-unit-btn" },
        { "action": "expectText", "text": "Custom Hooks" },
        { "action": "click", "testId": "edit-unit-UN01" },
        { "action": "fill", "testId": "unit-title-input", "value": "HTML5 Суурь" },
        { "action": "click", "testId": "save-unit-btn" },
        { "action": "expectText", "text": "HTML5 Суурь" },
        { "action": "click", "testId": "delete-unit-UN01" },
        { "action": "expectNotText", "text": "HTML5 Суурь" }
      ]
    }
  ],
