{
  "projectName": "StudyQuest",
  "version": "2.0.0",
  "roles": ["STUDENT", "TEACHER"],
  "routes": [
    "/login",
    "/dashboard",
    "/practice",
    "/practice/:courseId",
    "/topics",
    "/quiz/:unitId",
    "/quiz/result",
    "/admin/questions",
    "/admin/courses",
    "/explore",
    "/explore/lecture/:id",
    "/leaderboard",
    "/ui-states"
  ],
  "teamMembers": [
    {
      "taskId": "TASK-01",
      "name": "А. Төгөлдөр",
      "role": "Frontend / Auth & Dashboard",
      "routes": ["/login", "/dashboard"],
      "apiEndpoints": ["POST /api/auth/login", "GET /api/user/profile"],
      "tests": [
        "frontend/tests/Login.test.jsx",
        "frontend/tests/ProtectedRoute.test.jsx"
      ]
    },
    {
      "taskId": "TASK-02",
      "name": "Мөнхбаяр",
      "role": "Frontend & Backend / Practice & Question CRUD",
      "routes": ["/practice", "/quiz/:unitId", "/admin/questions"],
      "apiEndpoints": [
        "GET /api/courses/practice",
        "GET /api/quiz/:unitId",
        "POST /api/admin/questions",
        "PUT /api/admin/questions/:id"
      ],
      "tests": ["backend/tests/questions_crud.test.js"]
    },
    {
      "taskId": "TASK-03",
      "name": "Тэмүүлэн (Temka)",
      "studentId": "B242270046",
      "role": "Frontend / Horizontal Learning Path & Topics CRUD",
      "routes": ["/practice/:courseId", "/topics", "/quiz/result"],
      "apiEndpoints": [
        "GET /api/units/path/:courseId",
        "GET /api/topics/:unitId",
        "POST /api/units/path/:courseId",
        "PUT /api/units/path/:id",
        "DELETE /api/units/path/:id"
      ],
      "tests": [
        "frontend/tests/HorizontalPath.test.jsx"
      ]
    },
    {
      "taskId": "TASK-04",
      "name": "Д. Баттөмөр",
      "role": "Frontend & Backend / Quiz Engine & Course CRUD",
      "routes": ["/quiz/result", "/admin/courses"],
      "apiEndpoints": [
        "POST /api/quiz/submit",
        "POST /api/admin/courses",
        "DELETE /api/admin/courses/:id"
      ],
      "tests": [
        "frontend/tests/TeacherRoom.test.jsx",
        "frontend/tests/CourseForm.test.jsx"
      ]
    },
    {
      "taskId": "TASK-05",
      "name": "Хүслэн О.",
      "role": "Frontend / Explore Library with Search",
      "routes": ["/explore", "/explore/lecture/:id"],
      "apiEndpoints": ["GET /api/courses/explore", "GET /api/lectures/:id"],
      "tests": ["frontend/tests/LectureDetail.test.jsx"]
    },
    {
      "taskId": "TASK-06",
      "name": "Цогжавхлан Б.",
      "role": "Frontend & QA / Leaderboard, UI States & E2E Testing",
      "routes": ["/leaderboard", "/ui-states"],
      "apiEndpoints": ["GET /api/leaderboard"],
      "tests": [
        "frontend/tests/Leaderboard.test.jsx",
        "frontend/tests/GlobalUIStates.test.jsx"
      ]
    }
  ],
  "scenarios": [
    {
      "id": "task01-auth-role",
      "taskId": "TASK-01",
      "tags": ["role"],
      "route": "/login",
      "description": "Зөв нэр/нууц үгээр нэвтэрч /dashboard нээгдэнэ, оюутанд room-computer, багшид room-board харагдана.",
      "steps": [
        { "action": "goto", "url": "/login" },
        { "action": "fill", "testId": "login-name-input", "value": "temuulen" },
        { "action": "fill", "testId": "login-password-input", "value": "student123" },
        { "action": "click", "testId": "login-submit-btn" },
        { "action": "expectVisible", "testId": "page-dashboard" },
        { "action": "expectVisible", "testId": "room-computer" }
      ]
    },
    {
      "id": "task01-auth-validation",
      "taskId": "TASK-01",
      "tags": ["validation"],
      "route": "/login",
      "description": "Хоосон нэр нууц үг оруулахад validation алдааны мэдээлэл харуулна.",
      "steps": [
        { "action": "goto", "url": "/login" },
        { "action": "click", "testId": "login-submit-btn" },
        { "action": "expectVisible", "testId": "login-name-error" },
        { "action": "expectVisible", "testId": "login-password-error" }
      ]
    },
    {
      "id": "task03-path-role",
      "taskId": "TASK-03",
      "tags": ["role"],
      "route": "/practice/C01",
      "description": "STUDENT эрхээр зөвхөн суралцах зам харагдана, TEACHER эрх рүү шилжихэд нэгж/сэдэв удирдах CRUD самбар нээгдэнэ.",
      "steps": [
        { "action": "goto", "url": "/practice/C01" },
        { "action": "expectHidden", "testId": "teacher-path-controls" },
        { "action": "click", "testId": "role-toggle-btn" },
        { "action": "expectVisible", "testId": "teacher-path-controls" }
      ]
    },
    {
      "id": "task03-path-validation",
      "taskId": "TASK-03",
      "tags": ["validation"],
      "route": "/practice/C01",
      "description": "Нэгж нэмэх форм дээр хоосон нэр болон буруу XP утга оруулахад validation алдааны мэдээлэл харуулна.",
      "steps": [
        { "action": "goto", "url": "/practice/C01" },
        { "action": "click", "testId": "role-toggle-btn" },
        { "action": "click", "testId": "open-create-unit-btn" },
        { "action": "fill", "testId": "unit-title-input", "value": "" },
        { "action": "fill", "testId": "unit-xp-input", "value": "3" },
        { "action": "click", "testId": "save-unit-btn" },
        { "action": "expectVisible", "testId": "error-unit-title" },
        { "action": "expectVisible", "testId": "error-unit-xp" }
      ]
    },
    {
      "id": "task03-path-crud",
      "taskId": "TASK-03",
      "tags": ["crud"],
      "route": "/practice/C01",
      "description": "Сургалтын замналын нэгж дээр Create -> Read -> Update -> Delete бүтэн урсгал ажиллана.",
      "steps": [
        { "action": "goto", "url": "/practice/C01" },
        { "action": "click", "testId": "role-toggle-btn" },
        { "action": "click", "testId": "open-create-unit-btn" },
        { "action": "fill", "testId": "unit-title-input", "value": "Custom Hooks" },
        { "action": "fill", "testId": "unit-xp-input", "value": "60" },
        { "action": "click", "testId": "save-unit-btn" },
        { "action": "expectText", "text": "Custom Hooks" },
        { "action": "click", "testId": "edit-unit-UN01" },
        { "action": "fill", "testId": "unit-title-input", "value": "HTML5 Суурь" },
        { "action": "click", "testId": "save-unit-btn" },
        { "action": "expectText", "text": "HTML5 Суурь" },
        { "action": "click", "testId": "delete-unit-UN01" },
        { "action": "expectNotText", "text": "HTML5 Суурь" }
      ]
    }
  ]
}