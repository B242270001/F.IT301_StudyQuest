  "authScenario": {
    "taskId": "TASK-01",
    "mode": "bearer",
    "description": "JWT (HS256) Authorization: Bearer <token>. Token-ий jti MongoDB Session-д хадгалагдаж logout хийхэд хүчингүй болно.",
    "register": {
      "method": "POST",
      "path": "/api/auth/register",
      "body": { "username": "lab6user", "password": "secret123", "displayName": "Лаб6 Хэрэглэгч", "gender": "female" },
      "expectedStatus": 201,
      "tokenField": "token"
    },
    "login": {
      "method": "POST",
      "path": "/api/auth/login",
      "body": { "username": "temuulen", "password": "student123" },
      "expectedStatus": 200,
      "tokenField": "token"
    },
    "protected": [
      { "method": "GET", "path": "/api/user/profile", "authorizedStatus": 200, "anonymousStatus": 401 },
      { "method": "GET", "path": "/api/notes", "authorizedStatus": 200, "anonymousStatus": 401 },
      { "method": "GET", "path": "/api/user/avatar", "authorizedStatus": 200, "anonymousStatus": 401 },
      { "taskId": "TASK-06", "method": "GET", "path": "/api/me/achievements", "authorizedStatus": 200, "anonymousStatus": 401 },
      { "taskId": "TASK-06", "method": "POST", "path": "/api/me/achievements/claim", "authorizedStatus": 200, "anonymousStatus": 401 }
    ],
    "roleProtected": [
      {
        "method": "DELETE",
        "path": "/api/users/U07",
        "requiredRole": "TEACHER",
        "anonymousStatus": 401,
        "forbidden": { "login": { "username": "temuulen", "password": "student123" }, "expectedStatus": 403 },
        "allowed": { "login": { "username": "bagsh", "password": "teacher123" }, "expectedStatus": 204 }
      },
      {
        "taskId": "TASK-06",
        "method": "PUT",
        "path": "/api/achievements/A02",
        "body": { "xpReward": 50 },
        "requiredRole": "TEACHER",
        "anonymousStatus": 401,
        "forbidden": { "login": { "username": "temuulen", "password": "student123" }, "expectedStatus": 403 },
        "allowed": { "login": { "username": "bagsh", "password": "teacher123" }, "expectedStatus": 200 }
      },
      {
        "taskId": "TASK-06",
        "method": "POST",
        "path": "/api/achievements",
        "body": { "title": "Лаб6 тэмдэг", "type": "XP_TOTAL", "threshold": 1000, "xpReward": 25 },
        "requiredRole": "TEACHER",
        "anonymousStatus": 401,
        "forbidden": { "login": { "username": "temuulen", "password": "student123" }, "expectedStatus": 403 },
        "allowed": { "login": { "username": "bagsh", "password": "teacher123" }, "expectedStatus": 201 }
      }
    ],
    "logout": { "method": "POST", "path": "/api/auth/logout", "expectedStatus": 204, "tokenRevoked": true }
  },
